---
import HeaderLink from './HeaderLink.astro';
import { Menu } from '@lucide/astro';
import Logo from './Logo.astro';
---

<header>
	<nav class="container grid grid-cols-[168px_1fr_auto] py-4 items-center gap-2">
		<a href="/" class="text-2xl font-bold text-main-200 flex items-center gap-2">
			<span class="text-3xl">🏔️</span> Malang Raya
		</a>
		<div class="hidden lg:flex gap-10 items-center mx-auto">
			<HeaderLink href="/">Beranda</HeaderLink>
			<HeaderLink href="/destinasi">Destinasi</HeaderLink>
			<HeaderLink href="/kuliner">Kuliner</HeaderLink>
			<HeaderLink href="/tentang-kami">Tentang Kami</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/contact">Kontak</HeaderLink>
		</div>
		<a href="https://wa.me/6281234567890" class="btn ml-auto bg-[linear-gradient(125deg,var(--color-main-100),var(--color-main-200))] text-white border-0 rounded-xl text-lg py-3 px-6 h-auto shadow-xl hover:shadow-2xl">Pesan Tiket</a>
			<label for="my-drawer-2" aria-label="open sidebar" class="btn btn-square btn-ghost lg:hidden">
         <Menu />
        </label>
	</nav>
</header>
