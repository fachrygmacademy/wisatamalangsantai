---
// File: src/pages/destinasi/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import { db } from '../../lib/db';

// Mengambil data dari tabel destinasi_malang
const { data: rows } = await db.from('destinasi_malang').select('*').order('rating', { ascending: false }).order('id', { ascending: false });
const destinasiList = (rows || []) as any[];
---

<MainLayout title="Destinasi Wisata Malang Raya">
  <main class="container mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-white mb-4">Destinasi Wisata Terbaik di Malang Raya</h1>
      <p class="text-lg text-gray-300">Temukan pesona alam, taman hiburan kelas dunia, hingga wisata sejarah yang memukau.</p>
    </div>

    {destinasiList.length === 0 ? (
      <div></div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {destinasiList.map((item) => (
          <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-2xl transition-all duration-300 flex flex-col">
            <div class="relative">
              <img 
                src={item.foto_url || '/img/waterfall.jpg'} 
                alt={item.nama_destinasi} 
                class="w-full h-56 object-cover"
              />
              <span class="absolute top-4 left-4 bg-emerald-600 text-white text-xs font-semibold px-3 py-1 rounded-full shadow">
                {item.kategori}
              </span>
              <span class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm text-yellow-500 font-bold text-sm px-2.5 py-1 rounded-full shadow">
                ★ {item.rating}
              </span>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h2 class="text-xl font-bold mb-2 text-gray-800">
                  <a href={`/destinasi/${item.slug || item.id}`} class="hover:text-emerald-600 transition-colors">
                    {item.nama_destinasi}
                  </a>
                </h2>
                <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                  {item.deskripsi}
                </p>
              </div>

              <div class="border-t border-gray-100 pt-4 mt-2 space-y-2 text-xs text-gray-600">
                <div class="flex items-center gap-2">
                  <span>📍</span>
                  <span class="truncate">{item.lokasi}</span>
                </div>
                <div class="flex items-center justify-between font-medium mb-4">
                  <span class="text-gray-500">🕒 {item.jam_operasional || '08:00 - 17:00'}</span>
                  <span class="text-blue-600 font-bold text-sm">{item.harga_tiket}</span>
                </div>
                <div class="flex gap-2 mt-4 pt-2">
                  <a target="_blank" href={`https://wa.me/6281234567890?text=Halo%20admin,%20saya%20ingin%20bertanya%20tentang%20destinasi%20wisata%20${item.nama_destinasi}`} class="flex-1 text-center bg-emerald-50 text-emerald-600 border border-emerald-200 hover:bg-emerald-600 hover:text-white font-semibold py-2 px-3 rounded-lg transition-colors">
                    Chat Admin
                  </a>
                  <a href={`/destinasi/${item.slug || item.id}`} class="flex-1 text-center bg-blue-50 text-blue-600 border border-blue-200 hover:bg-blue-600 hover:text-white font-semibold py-2 px-3 rounded-lg transition-colors">
                    Lihat Detail
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </main>
</MainLayout>