---
export const prerender = false;
import Layout from "../../layouts/MainLayout.astro";
import { db } from "../../lib/db";
import BlogCard from "../../components/card/BlogCard.astro";
import Pagination from "../../components/Pagination.astro";
import { SITE_DESCRIPTION } from "../../consts";

const pageParam = Astro.url.searchParams.get('page');
let currentPage = 1;
if (pageParam && !isNaN(Number(pageParam))) {
  currentPage = Number(pageParam);
}

const pageSize = 6;
const offset = (currentPage - 1) * pageSize;

const { count: totalItemsCount } = await db.from('blog_malang').select('*', { count: 'exact', head: true });
const totalItems = totalItemsCount || 0;
const lastPage = Math.ceil(totalItems / pageSize) || 1;

const { data } = await db.from('blog_malang')
  .select('*')
  .order('created_at', { ascending: false })
  .range(offset, offset + pageSize - 1);
const posts = data || [];

const page = {
  data: posts,
  currentPage,
  lastPage,
  url: {
    prev: currentPage > 1 ? (currentPage === 2 ? '/blog' : `/blog?page=${currentPage - 1}`) : undefined,
    next: currentPage < lastPage ? `/blog?page=${currentPage + 1}` : undefined,
  }
};
---

<Layout title="Blog" description={SITE_DESCRIPTION}>
  <div class="container py-5 lg:py-15">
    <!-- Breadcrumbs -->
    <div class="breadcrumbs text-sm mb-6">
      <ul class="flex! flex-wrap">
        <li><a href="/">Home</a></li>
        <li>Blog</li>
      </ul>
    </div>

    <h1>BLOG</h1>

    <section>
      <ul
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 items-stretch mt-8"
      >
        {
          page.data.map((post: any) => (
            <li>
              <BlogCard 
                id={post.slug} 
                slug="/blog" 
                data={{
                  title: post.judul,
                  description: post.kutipan,
                  pubDate: new Date(post.created_at),
                  heroImage: post.foto_url,
                  heroImageAlt: post.foto_alt
                }} 
              />
            </li>
          ))
        }
        {page.data.length === 0 && (
          <li class="col-span-3 text-center py-10 text-gray-500">
            Belum ada artikel yang dipublikasikan.
          </li>
        )}
      </ul>

      {page.lastPage > 1 && <Pagination page={page} />}
    </section>
  </div>
</Layout>
