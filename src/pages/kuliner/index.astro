---
// File: src/pages/kuliner/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import { db } from '../../lib/db';

// Mengambil data dari MySQL diurutkan dari rating tertinggi
const { data: rows } = await db.from('kuliner_malang').select('*').order('rating', { ascending: false }).order('id', { ascending: false });
const kulinerList = (rows || []) as any[];
---

<MainLayout title="Kuliner Khas Malang Raya">
  <main class="container mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-white mb-4">Jelajahi Kuliner Malang Raya</h1>
      <p class="text-lg text-gray-300">Rekomendasi tempat makan legendaris, kafe hits, hingga jajanan khas Malang.</p>
    </div>

    {kulinerList.length === 0 ? (
      <div></div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {kulinerList.map((item) => (
          <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-2xl transition-all duration-300 flex flex-col">
            <div class="relative">
              <img 
                src={item.foto_url || '/img/bakso.jpg'} 
                alt={item.nama_tempat} 
                class="w-full h-52 object-cover"
              />
              <span class="absolute top-4 left-4 bg-blue-600 text-white text-xs font-semibold px-3 py-1 rounded-full shadow">
                {item.kategori}
              </span>
              <span class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm text-yellow-500 font-bold text-sm px-2.5 py-1 rounded-full shadow">
                ★ {item.rating}
              </span>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h2 class="text-xl font-bold mb-2 text-gray-800">
                  <a href={`/kuliner/${item.slug || item.id}`} class="hover:text-blue-600 transition-colors">
                    {item.nama_tempat}
                  </a>
                </h2>
                <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                  {item.deskripsi}
                </p>
              </div>

              <div class="border-t border-gray-100 pt-4 mt-2 space-y-2 text-xs text-gray-600">
                <div class="flex items-center gap-2">
                  <span>📍</span>
                  <span class="truncate">{item.lokasi}</span>
                </div>
                <div class="flex justify-between items-center font-medium mb-4">
                  <span class="text-gray-400">Kisaran Harga:</span>
                  <span class="font-bold text-green-600 text-sm">{item.kisaran_harga}</span>
                </div>
                <div class="mt-4 pt-2">
                  <a target="_blank" href={`https://www.google.com/maps/search/?api=1&query=${item.lokasi}`} class="block w-full text-center bg-blue-50 text-blue-600 border border-blue-200 hover:bg-blue-600 hover:text-white font-semibold py-2 px-3 rounded-lg transition-colors">
                    Kunjungi Lokasi
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </main>
</MainLayout>